{
  "name": "playwright-portfolio-framework",
  "version": "1.0.0",
  "description": "A production-style end-to-end and API test automation framework built with Playwright + TypeScript, using the Page Object Model, data-driven fixtures, and CI/CD reporting.",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:e2e": "playwright test tests/e2e",
    "test:api": "playwright test tests/api",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "codegen": "playwright codegen",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write .",
    "install:browsers": "playwright install --with-deps"
  },
  "keywords": ["playwright", "typescript", "test-automation", "e2e-testing", "api-testing", "page-object-model", "ci-cd"],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.7.0",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "dotenv": "^16.4.5",
    "eslint": "^8.57.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.2"
  }
}
